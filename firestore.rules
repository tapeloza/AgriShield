rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /publications/{publicationId} {
      allow read: if true;
      allow create: if owns(request.resource.data.owner)
        && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.role == 'specialist'
        && request.resource.data.keys().hasOnly(['owner', 'title', 'provenance', 'content', 'permission', 'publishedAt'])
        && request.resource.data.permission == 'granted'
        && request.resource.data.publishedAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 150
        && request.resource.data.provenance is string
        && request.resource.data.provenance.size() >= 1 && request.resource.data.provenance.size() <= 250
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1 && request.resource.data.content.size() <= 12000;
      allow delete: if owns(resource.data.owner);
    }

    match /accounts/{uid} {
      allow get: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role == 'specialist';

      match /sensors/{sensorId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && sensorId.matches('^[A-Z0-9][A-Z0-9-]{1,31}$')
          && request.resource.data.keys().hasOnly(['plot', 'bed', 'landmark', 'mapEmbed'])
          && request.resource.data.plot is string
          && request.resource.data.plot.size() >= 1 && request.resource.data.plot.size() <= 80
          && request.resource.data.bed is string
          && request.resource.data.bed.size() >= 1 && request.resource.data.bed.size() <= 80
          && request.resource.data.landmark is string
          && request.resource.data.landmark.size() <= 120
          && request.resource.data.get('mapEmbed', '') is string
          && request.resource.data.get('mapEmbed', '').size() <= 2048
          && (request.resource.data.get('mapEmbed', '') == ''
            || request.resource.data.mapEmbed.matches('^https://www[.]google[.]com/maps/embed[?]pb=.+$'));
      }

      match /readings/{readingId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly(['sensorId', 'crop', 'time', 'source', 'moisture'])
          && request.resource.data.sensorId is string
          && request.resource.data.sensorId.matches('^[A-Z0-9][A-Z0-9-]{1,31}$')
          && request.resource.data.crop in ['tomatoes', 'cabbage', 'morogo']
          && request.resource.data.time is int
          && request.resource.data.time > 0
          && request.resource.data.source in ['esp32', 'mock']
          && request.resource.data.moisture is number
          && request.resource.data.moisture >= 0 && request.resource.data.moisture <= 100;
      }
    }
  }
}
