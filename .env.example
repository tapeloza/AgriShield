# Copy to .env.local to enable the mock sensor. Restart Vite after changes.
AGRISHIELD_SENSOR_ORIGIN=http://127.0.0.1:8787

# Optional Firebase Authentication web app configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional Google Maps Embed API key. A Google Maps Share embed works without this setting.
VITE_GOOGLE_MAPS_EMBED_KEY=
